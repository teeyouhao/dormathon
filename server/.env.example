# Copy this file to server/.env and fill in real values.
# server/.env is gitignored — never commit real keys.

# ---- Supabase (persists fetched reels + related metadata) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_PUBLISH_KEY=your-publish-key
SUPABASE_ACCESS_TOKEN=your-access-token
SUPABASE_REELS_TABLE=reels

# ---- YouTube Data API v3 (official, free tier) ----
YOUTUBE_API_KEY=

# ---- Instagram (Apify, server-only token; never use a VITE_ prefix) ----
APIFY_TOKEN=
INSTAGRAM_SCRAPING_ENABLED=false
# Each run uses #mostviewed, #trending and #viral: 3 URLs x this limit.
# Start small. Range: 1-30 per hashtag; the display limit is separate.
APIFY_INSTAGRAM_RESULTS_LIMIT=3
# Leave blank to omit the date filter.
APIFY_INSTAGRAM_ONLY_POSTS_NEWER_THAN=7 days
# In-memory cache and failure cooldown; shared by concurrent requests.
APIFY_INSTAGRAM_CACHE_MINUTES=30
# USD cap per run (0.01-1); actual pricing/credits depend on your Apify account.
APIFY_INSTAGRAM_MAX_CHARGE_USD=0.10
# Remote Actor timeout; HTTP deadline is 15 seconds longer. No automatic retries.
APIFY_INSTAGRAM_TIMEOUT_SECONDS=180

# ---- TikTok (Playwright headless browser) ----
TIKTOK_SCRAPING_ENABLED=false

# ---- AI provider: local | openai | anthropic ----
AI_PROVIDER=local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Server ----
PORT=3001
